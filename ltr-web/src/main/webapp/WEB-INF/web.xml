<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Land Title Registry Web Application</display-name>
    <description>
        Land Title Registry System - IBM WebSphere Application Server 9.x
        Java 8 / Maven 3.x
    </description>

    <!-- ── Default Welcome Page ─────────────────────────────────────────── -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ── Security Constraints (enforced by WAS JAAS/LDAP) ────────────── -->

    <!-- Public read access for title search (authenticated users only) -->
    <security-constraint>
        <display-name>Registry Read Access</display-name>
        <web-resource-collection>
            <web-resource-name>Title Search</web-resource-name>
            <url-pattern>/api/titles/*</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>REGISTRY_OFFICER</role-name>
            <role-name>REGISTRY_SUPERVISOR</role-name>
            <role-name>REGISTRY_ADMIN</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!-- Write access requires at least OFFICER role -->
    <security-constraint>
        <display-name>Registry Write Access</display-name>
        <web-resource-collection>
            <web-resource-name>Title Mutations</web-resource-name>
            <url-pattern>/api/titles/*</url-pattern>
            <http-method>POST</http-method>
            <http-method>PUT</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>REGISTRY_OFFICER</role-name>
            <role-name>REGISTRY_SUPERVISOR</role-name>
            <role-name>REGISTRY_ADMIN</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!-- Transfer operations -->
    <security-constraint>
        <display-name>Transfer Access</display-name>
        <web-resource-collection>
            <web-resource-name>Transfers</web-resource-name>
            <url-pattern>/api/transfers/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>REGISTRY_OFFICER</role-name>
            <role-name>REGISTRY_SUPERVISOR</role-name>
            <role-name>REGISTRY_ADMIN</role-name>
        </auth-constraint>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!-- ── WAS Form-Based Login ──────────────────────────────────────────── -->
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>LandTitleRegistryRealm</realm-name>
        <form-login-config>
            <form-login-page>/pages/login.jsp</form-login-page>
            <form-error-page>/pages/login-error.jsp</form-error-page>
        </form-login-config>
    </login-config>

    <!-- ── Security Roles ────────────────────────────────────────────────── -->
    <security-role>
        <description>Registry data entry officer</description>
        <role-name>REGISTRY_OFFICER</role-name>
    </security-role>
    <security-role>
        <description>Registry supervisor — approves transfers</description>
        <role-name>REGISTRY_SUPERVISOR</role-name>
    </security-role>
    <security-role>
        <description>System administrator — full access</description>
        <role-name>REGISTRY_ADMIN</role-name>
    </security-role>

    <!-- ── JNDI Resource Reference for DataSource ────────────────────────── -->
    <resource-ref>
        <description>WAS JDBC DataSource for Land Title Registry</description>
        <res-ref-name>jdbc/LandTitleDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

    <!-- ── EJB Local Reference (in-EAR injection) ────────────────────────── -->
    <ejb-local-ref>
        <ejb-ref-name>ejb/LandTitleRegistryLocal</ejb-ref-name>
        <ejb-ref-type>Session</ejb-ref-type>
        <local>com.trianz.ltr.ejb.LandTitleRegistryLocal</local>
        <ejb-link>LandTitleRegistry</ejb-link>
    </ejb-local-ref>

    <!-- ── Session Config ────────────────────────────────────────────────── -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <secure>true</secure>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ── Error Pages ───────────────────────────────────────────────────── -->
    <error-page>
        <error-code>401</error-code>
        <location>/pages/error-401.html</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/pages/error-403.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/pages/error-500.html</location>
    </error-page>

</web-app>
