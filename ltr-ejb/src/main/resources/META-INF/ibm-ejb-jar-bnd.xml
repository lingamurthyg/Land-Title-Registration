<?xml version="1.0" encoding="UTF-8"?>
<!--
    ibm-ejb-jar-bnd.xml - IBM WebSphere Application Server EJB Bindings
    =====================================================================
    This file is WAS-PROPRIETARY and provides:
      1. Custom JNDI names for EJB homes (pre-Java EE 6 naming)
      2. Resource reference bindings (maps res-ref to actual DataSource JNDI)
      3. Security role bindings

    MODERNIZATION NOTE (Concierto Modernize):
      This file has NO equivalent on Open Liberty or standard Java EE.
      During migration:
        - JNDI names → standard java:global/<app>/<module>/<bean> or CDI injection
        - Resource refs → server.xml <dataSource> + @Resource injection
        - Security roles → ibm-application-bnd.xml or Liberty's <application-bnd>
-->
<ejb-jar-bnd
    xmlns="http://websphere.ibm.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee
        http://websphere.ibm.com/xml/ns/javaee/ibm-ejb-jar-bnd_1_0.xsd"
    version="1.0">

    <session name="LandTitleRegistry">

        <!-- WAS legacy JNDI binding — used by remote EJB clients -->
        <interface class="com.trianz.ltr.ejb.LandTitleRegistryRemote"
                   binding-name="ejb/LandTitleRegistryRemote"/>
        <interface class="com.trianz.ltr.ejb.LandTitleRegistryLocal"
                   binding-name="ejblocal:LandTitleRegistryLocal"/>

        <!-- Bind the res-ref jdbc/LandTitleDS to the WAS-configured DataSource -->
        <resource-ref name="jdbc/LandTitleDS"
                      binding-name="jdbc/LandTitleDS"/>

    </session>

</ejb-jar-bnd>
